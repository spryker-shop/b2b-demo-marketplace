{
  "data": {
    "type": "dynamic-fixtures",
    "attributes": {
      "synchronize": true,
      "operations": [
        {
          "type": "helper",
          "name": "haveStore",
          "key": "store",
          "arguments": [
            {
              "name": "{{STORE_NAME}}"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveTaxSet",
          "key": "taxSet",
          "arguments": [{}]
        },
        {
          "type": "helper",
          "name": "haveConfirmedCustomer",
          "key": "customer",
          "arguments": [
            {
              "locale_name": "{{LOCALE_NAME}}",
              "password": "{{DEFAULT_PASSWORD}}"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveCompany",
          "key": "company",
          "arguments": [
            {
              "isActive": true,
              "status": "approved"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveCompanyBusinessUnit",
          "key": "businessUnit",
          "arguments": [
            {
              "fkCompany": "#company.id_company"
            }
          ]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "addCartItemPermission",
          "arguments": ["AddCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "changeCartItemPermission",
          "arguments": ["ChangeCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "removeCartItemPermission",
          "arguments": ["RemoveCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "placeOrderPermission",
          "arguments": ["PlaceOrderPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "placeOrderWithAmountUpToPermission",
          "arguments": ["PlaceOrderWithAmountUpToPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "haveCompanyRoleWithPermissions",
          "arguments": [
            {
              "isDefault": true,
              "fkCompany": "#company.id_company"
            },
            [
              "#addCartItemPermission",
              "#changeCartItemPermission",
              "#removeCartItemPermission",
              "#placeOrderPermission",
              "#placeOrderWithAmountUpToPermission"
            ]
          ]
        },
        {
          "type": "helper",
          "name": "haveCompanyUser",
          "key": "companyUser",
          "arguments": [
            {
              "customer": "#customer",
              "fkCustomer": "#customer.id_customer",
              "fkCompany": "#company.id_company",
              "fkCompanyBusinessUnit": "#businessUnit.id_company_business_unit"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveFullProduct",
          "key": "product",
          "arguments": [
            {},
            {
              "idTaxSet": "#taxSet.id_tax_set"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveProductImageSet",
          "arguments": [
            {
              "name": "default",
              "idProduct": "#product.id_product_concrete"
            },
            {}
          ]
        },
        {
          "type": "helper",
          "name": "havePriceProduct",
          "key": "productPrice",
          "arguments": [
            {
              "skuProductAbstract": "#product.abstract_sku",
              "skuProduct": "#product.sku",
              "moneyValue": {
                "netAmount": 30000,
                "grossAmount": 30000
              }
            }
          ]
        },
        {
          "type": "helper",
          "name": "havePriceProductAbstract",
          "arguments": [
            "#product.fk_product_abstract",
            {
              "skuProductAbstract": "#product.abstract_sku",
              "moneyValue": {
                "netAmount": 30000,
                "grossAmount": 30000
              }
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveProductInStockForStore",
          "arguments": [
            "#store",
            {
              "sku": "#product.sku",
              "isNeverOutOfStock": "1"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveProductOffer",
          "key": "productOffer",
          "arguments": [
            {
              "idProductConcrete": "#product.id_product_concrete",
              "concreteSku": "#product.sku",
              "merchantReference": "{{MERCHANT_REFERENCE}}",
              "isActive": true,
              "approvalStatus": "approved"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveProductOfferStore",
          "arguments": ["#productOffer", "#store"]
        },
        {
          "type": "helper",
          "name": "haveProductOfferStock",
          "arguments": [
            {
              "idProductOffer": "#productOffer.id_product_offer",
              "productOfferReference": "#productOffer.product_offer_reference",
              "isNeverOutOfStock": true,
              "stock": {
                "name": "{{MERCHANT_WAREHOUSE_NAME}}"
              }
            }
          ]
        }
      ]
    }
  }
}
