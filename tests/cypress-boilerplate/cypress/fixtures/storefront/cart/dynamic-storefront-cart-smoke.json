{
  "data": {
    "type": "dynamic-fixtures",
    "attributes": {
      "synchronize": true,
      "operations": [
        {
          "type": "helper",
          "name": "haveStore",
          "key": "store",
          "arguments": [{ "name": "{{STORE_NAME}}" }]
        },
        {
          "type": "helper",
          "name": "haveLocale",
          "key": "storeLocale",
          "arguments": [{ "locale_name": "{{LOCALE_NAME}}" }]
        },
        {
          "type": "helper",
          "name": "getCurrencyByIsoCode",
          "key": "currencyTransfer",
          "arguments": ["{{CURRENCY_CODE}}"]
        },
        {
          "type": "helper",
          "name": "haveTaxSet",
          "key": "taxSet",
          "arguments": [{}]
        },
        {
          "type": "helper",
          "name": "haveConfirmedCustomer",
          "key": "customer",
          "arguments": [
            {
              "locale_name": "{{LOCALE_NAME}}",
              "password": "{{DEFAULT_PASSWORD}}"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveCompany",
          "key": "company",
          "arguments": [{ "isActive": true, "status": "approved" }]
        },
        {
          "type": "helper",
          "name": "haveCompanyBusinessUnit",
          "key": "businessUnit",
          "arguments": [{ "fkCompany": "#company.id_company" }]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "addCartItemPermission",
          "arguments": ["AddCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "changeCartItemPermission",
          "arguments": ["ChangeCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "removeCartItemPermission",
          "arguments": ["RemoveCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "haveCompanyRoleWithPermissions",
          "arguments": [
            { "isDefault": true, "fkCompany": "#company.id_company" },
            [
              "#addCartItemPermission",
              "#changeCartItemPermission",
              "#removeCartItemPermission"
            ]
          ]
        },
        {
          "type": "helper",
          "name": "haveCompanyUser",
          "key": "companyUser",
          "arguments": [
            {
              "customer": "#customer",
              "fkCustomer": "#customer.id_customer",
              "fkCompany": "#company.id_company",
              "fkCompanyBusinessUnit": "#businessUnit.id_company_business_unit"
            }
          ]
        },
        {
          "type": "builder",
          "name": "LocalizedAttributesBuilder",
          "key": "localizedAttribute"
        },
        {
          "type": "helper",
          "name": "haveFullProduct",
          "key": "product",
          "arguments": [
            {
              "isActive": true
            },
            {
              "idTaxSet": 1,
              "storeRelation": {
                "idStores": ["#store.id_store"]
              },
              "localizedAttributes": [
                { "locale": "#storeLocale", "name": "#localizedAttribute.name" }
              ]
            }
          ]
        },
        {
          "type": "helper",
          "name": "havePriceProduct",
          "key": "productPrice",
          "arguments": [
            {
              "skuProductAbstract": "#product.abstract_sku",
              "skuProduct": "#product.sku",
              "moneyValue": {
                "netAmount": "{{PRODUCT_PRICE_ABOVE_THRESHOLD}}",
                "grossAmount": "{{PRODUCT_PRICE_ABOVE_THRESHOLD}}",
                "currency": "#currencyTransfer",
                "store": "#store"
              }
            }
          ]
        },
        {
          "type": "helper",
          "name": "havePriceProductAbstract",
          "arguments": [
            "#product.fk_product_abstract",
            {
              "skuProductAbstract": "#product.abstract_sku",
              "moneyValue": {
                "netAmount": "{{PRODUCT_PRICE_ABOVE_THRESHOLD}}",
                "grossAmount": "{{PRODUCT_PRICE_ABOVE_THRESHOLD}}",
                "currency": "#currencyTransfer",
                "store": "#store"
              }
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveProductInStockForStore",
          "arguments": [
            "#store",
            { "sku": "#product.sku", "isNeverOutOfStock": "1" }
          ]
        },
        {
          "type": "helper",
          "name": "haveShipmentType",
          "key": "shipmentType",
          "arguments": [{ "key": "delivery" }]
        }
      ]
    }
  }
}
