BACK_OFFICE_URL=http://backoffice.eu.spryker.local
STOREFRONT_URL=http://yves.eu.spryker.local
GLUE_URL=http://glue.eu.spryker.local
MP_URL=http://mp.eu.spryker.local
DOCKER_CLI_URL=http://cli:9000
GLUE_BACKEND_URL=http://glue-backend.eu.spryker.local
PROJECT_LOCATION=../..

# Shop data the dynamic fixtures are created for. This is the single place to change when
# the project's store set changes (e.g. DE -> PL): the fixture payloads reference these as
# {{STORE_NAME}}, {{LOCALE_NAME}}, {{CURRENCY_CODE}}, {{COUNTRY_ISO2}} and
# {{DEFAULT_PASSWORD}} placeholders.
# STORE_NAME must match SPRYKER_DEFAULT_STORE (see config/Shared/default_store.php) and
# LOCALE_NAME must be one of that store's locales, since the storefront page objects
# browse the /en/ locale prefix.
STORE_NAME=DE
LOCALE_NAME=en_US
CURRENCY_CODE=EUR
COUNTRY_ISO2=DE
DEFAULT_PASSWORD=change123

# Merchant the generated product offers are created under. It has to be the merchant the
# static Merchant Portal user (user-data.json -> merchantPortalUser) belongs to, otherwise the
# merchant order is not visible to that user in the Merchant Portal.
MERCHANT_REFERENCE=MER000009
# Warehouse the generated product offers are stocked in. It must be a stock that is
# linked to the store above, otherwise the offer gets no availability and adding it to a
# cart fails with "Product is not available at the moment". This is the merchant warehouse
# belonging to MERCHANT_REFERENCE.
MERCHANT_WAREHOUSE_NAME=Office King MER000009 Warehouse 1
