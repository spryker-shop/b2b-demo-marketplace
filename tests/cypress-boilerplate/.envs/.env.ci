BACK_OFFICE_URL=http://backoffice.eu.spryker.local
STOREFRONT_URL=http://yves.eu.spryker.local
GLUE_URL=http://glue.eu.spryker.local
MP_URL=http://mp.eu.spryker.local
DOCKER_CLI_URL=http://cli:9000
GLUE_BACKEND_URL=http://glue-backend.eu.spryker.local

# Path from Cypress's cwd up to the repo root, where `docker/sdk` is cloned in CI.
PROJECT_LOCATION=../..

DEFAULT_PASSWORD=change123

# Price (minor units) of the fixture product. Must clear the store's hard-minimum and stay under
# its soft-minimum threshold (spy_sales_order_threshold) - no API exposes those, hence it lives here.
PRODUCT_PRICE_ABOVE_THRESHOLD=60000
