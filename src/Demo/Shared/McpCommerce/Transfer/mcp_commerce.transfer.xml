<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="McpAuthorizationCode" strict="true">
        <property name="idMcpAuthCode" type="int"/>
        <property name="code" type="string"/>
        <property name="clientIdentifier" type="string"/>
        <property name="customerReference" type="string"/>
        <property name="idCustomer" type="int"/>
        <property name="codeChallenge" type="string"/>
        <property name="codeChallengeMethod" type="string"/>
        <property name="redirectUri" type="string"/>
        <property name="scopes" type="string"/>
        <property name="expiresAt" type="string"/>
        <property name="isUsed" type="bool"/>
    </transfer>

    <transfer name="McpAuthorizationCodeRedemptionRequest" strict="true">
        <property name="code" type="string"/>
        <property name="clientIdentifier" type="string"/>
        <property name="redirectUri" type="string"/>
        <property name="codeVerifier" type="string"/>
    </transfer>

    <transfer name="McpAuthorizationCodeRedemptionResponse" strict="true">
        <property name="isSuccessful" type="bool"/>
        <property name="errorCode" type="string"/>
        <property name="errorMessage" type="string"/>
        <property name="mcpIdentity" type="McpIdentity"/>
        <property name="mcpAuthorizationCode" type="McpAuthorizationCode"/>
    </transfer>

    <transfer name="McpAccessToken" strict="true">
        <property name="idMcpAccessToken" type="int"/>
        <property name="identifier" type="string"/>
        <property name="clientIdentifier" type="string"/>
        <property name="customerReference" type="string"/>
        <property name="idCustomer" type="int"/>
        <property name="scopes" type="string"/>
        <property name="expiresAt" type="string"/>
        <property name="expiresIn" type="int"/>
        <property name="isRevoked" type="bool"/>
    </transfer>

    <transfer name="McpAccessTokenValidationResponse" strict="true">
        <property name="isValid" type="bool"/>
        <property name="errorCode" type="string"/>
        <property name="errorMessage" type="string"/>
        <property name="mcpIdentity" type="McpIdentity"/>
    </transfer>

    <transfer name="McpIdentity" strict="true">
        <property name="customerReference" type="string"/>
        <property name="idCustomer" type="int"/>
        <property name="clientIdentifier" type="string"/>
        <property name="scopes" type="string"/>
    </transfer>

    <transfer name="McpClientRegistrationRequest" strict="true">
        <property name="clientName" type="string"/>
        <property name="redirectUris" type="string[]" singular="redirectUri"/>
    </transfer>

    <transfer name="McpClientRegistrationResponse" strict="true">
        <property name="isSuccessful" type="bool"/>
        <property name="errorCode" type="string"/>
        <property name="errorMessage" type="string"/>
        <property name="invalidField" type="string"/>
        <property name="mcpClient" type="McpClient"/>
    </transfer>

    <transfer name="McpClient" strict="true">
        <property name="identifier" type="string"/>
        <property name="clientName" type="string"/>
        <property name="redirectUri" type="string"/>
        <property name="isConfidential" type="bool"/>
        <property name="isPkceRequired" type="bool"/>
    </transfer>

    <transfer name="McpClientRequest" strict="true">
        <property name="clientIdentifier" type="string"/>
    </transfer>

    <transfer name="McpClientResponse" strict="true">
        <property name="mcpClient" type="McpClient"/>
    </transfer>

    <transfer name="McpAccessTokenValidationRequest" strict="true">
        <property name="accessTokenIdentifier" type="string"/>
    </transfer>

</transfers>
