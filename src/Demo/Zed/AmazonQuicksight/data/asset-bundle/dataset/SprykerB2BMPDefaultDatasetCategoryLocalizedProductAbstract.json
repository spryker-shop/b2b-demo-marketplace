                "dataSourceArn": "arn:aws:quicksight:AwsRegion:AwsAccountId:datasource/SprykerB2BMPDefaultDataSource",
                "name": "Is Active Product Absrtact",
                "sqlQuery": "SELECT spy_product_abstract.id_product_abstract, (SUM(spy_product.is_active) >= 1) as is_active\nFROM spy_product_abstract\n    LEFT JOIN spy_product\nON spy_product_abstract.id_product_abstract = spy_product.fk_product_abstract\nGROUP BY spy_product_abstract.id_product_abstract",
                "columns": [
                    { "name": "id_product_abstract", "type": "INTEGER" },
                    { "name": "is_active", "type": "INTEGER" }
                ]
            }
        },
