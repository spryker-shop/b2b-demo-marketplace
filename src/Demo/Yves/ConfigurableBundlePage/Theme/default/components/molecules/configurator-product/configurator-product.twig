{% extends molecule('configurator-product', '@Pyz:ConfigurableBundlePage') %}

{% block price %}
    {% if can('SeePricePermissionPlugin') %}
        {% widget 'PriceProductWidget' args [data.product] with {
            embed: {
                currencyIsoCode: data.currencyIsoCode,
                priceClass: config.name ~ '__price',
            },
        } only %}
            {% block body %}
                {% if data.currentProductPrice.prices %}
                    {% include molecule('money-price') with {
                        class: embed.priceClass,
                        modifiers: ['block'],
                        data: {
                            amount: data.currentProductPrice.prices.DEFAULT | default(null),
                            originalAmount: data.currentProductPrice.prices.ORIGINAL | default(null),
                            currencyIsoCode: embed.currencyIsoCode,
                        },
                    } only %}
                    {% widget 'ProductGrossMarginWidget' args [data.currentProductPrice.grossMargin ?? 0, 'volume-price'] %}{% endwidget %}
                {% endif %}
            {% endblock %}
        {% endwidget %}
    {% endif %}
{% endblock %}