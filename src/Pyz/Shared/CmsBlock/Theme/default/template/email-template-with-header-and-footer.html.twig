{% if mail is not defined %}
    <!-- CMS_BLOCK_PLACEHOLDER : "content" -->
{% endif %}
{#
    Colors are resolved values of the ShopUi design tokens
    (src/Pyz/Yves/ShopUi/Theme/default/styles/design-tokens.css), inlined because
    email clients don't support CSS custom properties:

    #f5f5f5  --background-subtle          page background
    #ffffff  --background-page            card background
    #fafafa  --background-surface         support section background
    #e1e1e1  --grey-100                   card border, dividers
    #318272  --background-brand-primary   accent bar, buttons
    #226558  --text-brand                 links
    #3b3b3d  --text-primary               headings, strong text
    #4f5052  --text-secondary             body text
    #5a5b5c  --text-tertiary              supporting and footer text
    #ffffff  --text-inverse               button text
#}
<!doctype html>
<html lang="{{ (mail.locale.localeName ?? 'en_US') | replace({'_': '-'}) }}" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="format-detection" content="telephone=no, address=no, email=no, date=no" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{{ 'mail.trans.header.shop_name' | trans }}</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:AllowPNG/>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <style type="text/css">
        body, table, td, p, a, h1, h2, h3, h4, span, strong {
            font-family: Arial, Helvetica, sans-serif !important;
        }
    </style>
    <![endif]-->
    <style type="text/css">
        body,
        .bodyTable,
        .bodyCell {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            background: #f5f5f5;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            display: block;
            margin: 0;
            padding: 0;
            color: #3b3b3d;
            text-align: left;
            font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            font-weight: 700;
            font-size: 18px;
            line-height: 125%;
        }

        h1 {
            font-size: 26px;
        }

        h2 {
            font-size: 22px;
        }

        h3 {
            font-size: 20px;
        }

        p {
            padding: 0;
            margin: 10px;
            line-height: 150%;
        }

        table {
            border-collapse: collapse;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img,
        a img {
            border: 0;
            height: auto;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        p,
        a,
        li,
        td,
        blockquote {
            mso-line-height-rule: exactly;
        }

        p,
        a,
        li,
        td,
        body,
        table,
        blockquote {
            -ms-text-size-adjust: 100%;
            -webkit-text-size-adjust: 100%;
        }

        .sprykerTemplateContainer {
            max-width: 600px !important;
        }

        .sprykerTextContent {
            word-break: break-word;
        }

        .sprykerTextContent img {
            height: auto !important;
        }

        /* Content blocks rendered into the "content" placeholder. !important is required to win over their inline styles. */
        .sprykerTemplateBody .sprykerTextContent,
        .sprykerTemplateBody .sprykerTextContent p,
        .sprykerTemplateBody .sprykerTextContent span,
        .sprykerTemplateBody .sprykerTextContent div,
        .sprykerTemplateBody .sprykerButtonContent {
            font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
        }

        /* Aligns unwrapped paragraphs with the layout's 32px content inset; boxed blocks bring their own padding. */
        .sprykerTemplateBody p {
            margin: 10px 18px;
        }

        .sprykerTemplateBody .sprykerTextContent p {
            margin: 10px;
        }

        .sprykerTemplateBody .sprykerTextContent,
        .sprykerTemplateBody .sprykerTextContent p {
            color: #4f5052;
            font-size: 16px;
            line-height: 150%;
            text-align: left;
        }

        .sprykerTemplateBody .sprykerTextContent h1,
        .sprykerTemplateBody .sprykerTextContent h1 span {
            font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
            color: #4f5052 !important;
        }

        .sprykerTemplateBody .sprykerTextContent h1 strong {
            color: #3b3b3d !important;
        }

        .sprykerTemplateBody a,
        .sprykerTemplateBody .sprykerTextContent a,
        .sprykerTemplateBody .sprykerTextContent p a {
            color: #226558;
            font-weight: 600;
            text-decoration: underline;
        }

        .sprykerTemplateBody .sprykerButtonContentContainer {
            min-width: 30%;
            border-collapse: separate !important;
            border-radius: 8px !important;
            background-color: #318272 !important;
        }

        .sprykerTemplateBody .sprykerButtonContent {
            padding: 14px 28px !important;
            border-radius: 8px !important;
        }

        .sprykerTemplateBody .sprykerButtonContent a.sprykerButton {
            display: block;
            color: #ffffff !important;
            font-size: 16px !important;
            font-weight: 600 !important;
            line-height: 24px !important;
            text-decoration: none !important;
        }

        @media only screen and (max-width: 600px) {
            body,
            table,
            td,
            p,
            a,
            li,
            blockquote {
                -webkit-text-size-adjust: none !important;
            }

            body {
                width: 100% !important;
                min-width: 100% !important;
            }

            .sprykerTemplateContainer,
            .sprykerTextContentContainer,
            .sprykerBoxedTextContentContainer {
                max-width: 100% !important;
                width: 100% !important;
            }

            .sprykerBoxedTextContentContainer {
                min-width: 100% !important;
            }

            .sprykerEmailOuter {
                padding: 16px 8px !important;
            }

            .sprykerEmailHeader {
                padding: 20px 20px 16px !important;
            }

            .sprykerTemplateBody {
                padding: 4px 2px !important;
            }

            .sprykerEmailSignOff,
            .sprykerEmailSupport {
                padding-right: 20px !important;
                padding-left: 20px !important;
            }

            .sprykerEmailFooter {
                padding-right: 12px !important;
                padding-left: 12px !important;
            }

            .sprykerTemplateBody .sprykerButtonContentContainer {
                width: 100% !important;
            }

            h1 {
                font-size: 22px !important;
                line-height: 125% !important;
            }

            h2 {
                font-size: 20px !important;
                line-height: 125% !important;
            }

            h3 {
                font-size: 18px !important;
                line-height: 125% !important;
            }

            h4 {
                font-size: 16px !important;
                line-height: 150% !important;
            }

            .sprykerTemplateBody .sprykerTextContent,
            .sprykerTemplateBody .sprykerTextContent p {
                font-size: 16px !important;
                line-height: 150% !important;
            }

            /* Content components used by the email CMS blocks. */
            .sprykerEmailTitle {
                font-size: 22px !important;
                line-height: 30px !important;
            }

            .sprykerEmailHeading {
                font-size: 18px !important;
                line-height: 26px !important;
            }

            .sprykerEmailButton {
                width: 100% !important;
            }

            .sprykerEmailButton a {
                display: block !important;
            }

            .sprykerEmailCardCell {
                padding: 16px !important;
            }

            .sprykerEmailStack {
                display: block !important;
                width: 100% !important;
                padding-right: 0 !important;
            }

            .sprykerEmailStackLabel {
                padding-bottom: 0 !important;
            }
        }
    </style>
    {# Kept separate: Gmail discards a whole <style> block when it meets a selector it doesn't support. #}
    <style type="text/css">
        :root {
            color-scheme: light;
            supported-color-schemes: light;
        }

        a[x-apple-data-detectors] {
            color: inherit !important;
            text-decoration: none !important;
            font-size: inherit !important;
            font-family: inherit !important;
            font-weight: inherit !important;
            line-height: inherit !important;
        }

        a[href^=tel],
        a[href^=sms] {
            color: inherit;
            cursor: default;
            text-decoration: none;
        }
    </style>
</head>

<body style="height: 100%; margin: 0; padding: 0; width: 100%; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; background-color: #f5f5f5;">
<center>
    <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" height="100%" width="100%" class="bodyTable" style="border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; height: 100%; margin: 0; padding: 0; width: 100%; background-color: #f5f5f5;">
        <tr>
            <td align="center" valign="top" class="bodyCell sprykerEmailOuter" style="padding: 32px 16px; height: 100%; width: 100%; background-color: #f5f5f5;">
                <!--[if (gte mso 9)|(IE)]>
                <table role="presentation" align="center" border="0" cellspacing="0" cellpadding="0" width="600" style="width: 600px;">
                    <tr>
                        <td align="center" valign="top" width="600" style="width: 600px;">
                <![endif]-->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="sprykerTemplateContainer" style="border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; max-width: 600px !important;">
                    <tr>
                        <td valign="top">
                            <!-- CARD -->
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #ffffff; border: 1px solid #e1e1e1; border-radius: 12px;">
                                <!-- ACCENT BAR -->
                                <tr>
                                    <td height="4" style="height: 4px; font-size: 0; line-height: 0; mso-line-height-rule: exactly; background-color: #318272; border-radius: 11px 11px 0 0;">&nbsp;</td>
                                </tr>

                                <!-- HEADER -->
                                <tr>
                                    <td valign="top" align="left" class="sprykerEmailHeader" style="padding: 28px 32px 20px; border-bottom: 1px solid #e1e1e1;">
                                        <img src="{{ yves_url('/assets/static/images/email/logo-main.png') }}" alt="{{ 'mail.trans.header.shop_name' | trans }}" width="130" style="display: block; width: 130px; max-width: 130px; height: auto; border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; color: #3b3b3d; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 20px; font-weight: 700; line-height: 28px;">
                                    </td>
                                </tr>

                                <!-- CONTENT -->
                                <tr>
                                    <td valign="top" class="sprykerTemplateBody" style="padding: 16px 14px; background-color: #ffffff; color: #4f5052; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 150%; mso-line-height-rule: exactly; word-break: break-word;">
                                        {% block content %}
                                            {{ placeholders.content | raw }}
                                        {% endblock %}
                                    </td>
                                </tr>

                                <!-- SIGN-OFF -->
                                <tr>
                                    <td valign="top" class="sprykerEmailSignOff" style="padding: 8px 32px 32px; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; mso-line-height-rule: exactly; color: #4f5052; text-align: left;">
                                        <strong style="color: #3b3b3d; font-weight: 600;">{{ 'mail.trans.footer.shopping_experience' | trans }}</strong><br>
                                        {{ 'mail.trans.footer.your_team' | trans }}
                                    </td>
                                </tr>

                                <!-- SUPPORT -->
                                <tr>
                                    <td valign="top" class="sprykerEmailSupport" style="padding: 20px 32px; background-color: #fafafa; border-top: 1px solid #e1e1e1; border-radius: 0 0 11px 11px; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 22px; mso-line-height-rule: exactly; color: #4f5052; text-align: left; word-break: break-word;">
                                        {{ 'mail.trans.footer.if_you_have_further_questions' | trans }} <a href="mailto:info@spryker.com" target="_blank" style="color: #226558; font-weight: 600; text-decoration: underline;">{{ 'mail.trans.footer.contact_email_address' | trans }}</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td valign="top" align="center" class="sprykerEmailFooter" style="padding: 24px 32px 8px; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 20px; mso-line-height-rule: exactly; color: #5a5b5c; text-align: center; word-break: break-word;">
                            <strong style="color: #4f5052; font-weight: 600;">{{ 'mail.trans.footer.shop_name' | trans }}</strong><br>
                            {{ 'mail.trans.footer.shop_address' | trans }}, {{ 'mail.trans.footer.shop_zip_code' | trans }} {{ 'mail.trans.footer.shop_city' | trans }}<br>
                            <span style="white-space: nowrap;">{{ 'mail.trans.footer.shop_phone' | trans }}</span>
                            &nbsp;&middot;&nbsp;
                            <a href="mailto:info@spryker.com" target="_blank" style="color: #226558; font-weight: 600; text-decoration: underline;">{{ 'mail.trans.footer.contact_email_address' | trans }}</a>
                        </td>
                    </tr>
                </table>
                <!--[if (gte mso 9)|(IE)]>
                        </td>
                    </tr>
                </table>
                <![endif]-->
            </td>
        </tr>
    </table>
</center>
</body>
</html>
