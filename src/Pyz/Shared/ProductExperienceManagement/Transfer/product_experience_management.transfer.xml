<?xml version="1.0"?>
<!--
    TEMPORARY - remove once spryker-feature/product-experience-management is released with the fix.

    SOL-561 added the `uuid` column to `spy_stock` (via the uuid behavior in PEM's spy_stock.schema.xml)
    but did not declare the matching `uuid` property on `StockTransfer`. In spryker/suite the property
    happens to exist already, contributed by the Warehouse/PickingList modules (CC-20611, 2023), so the
    gap is invisible there. This demoshop installs none of those modules, so `StockTransfer` has no
    `uuid` and `$stockTransfer->fromArray($stockEntity->toArray())` throws:

        InvalidArgumentException: Missing property `uuid` in `Generated\Shared\Transfer\StockTransfer`

    Upstream fix: declare this property in PEM's own product_experience_management.transfer.xml,
    alongside the existing `StockProduct.stockUuid`.
-->
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="Stock">
        <property name="uuid" type="string" strict="true" description="A Universally Unique Identifier for an entity."/>
    </transfer>

</transfers>
