{% extends molecule('price-tolerance-bulk', '@SprykerFeature:OrderExperienceManagement') %}

{% block title %}
    <h3 class="{{ config.name }}__title">{{ 'recurring_orders.price_tolerance.products.title' | trans }}</h3>

    {% block mode %}
        {% set ignoreField = data.form.isProductPriceChangeIgnored %}
        {% set isIgnored = ignoreField.vars.checked %}
        {% set orderTolerance = data.form.orderTolerance.vars.value %}
        {% set hasOrderTolerance = orderTolerance is not empty and orderTolerance > 0 %}

        <fieldset class="{{ config.name }}__mode" {{ data.isLocked ? 'disabled' }} {{ qa('recurring-order-price-tolerances-ignore') }}>
            <legend class="{{ config.name }}__mode-legend">{{ 'recurring_orders.price_tolerance.mode.legend' | trans }}</legend>

            {# Real form field, driven by the radios below. #}
            <input type="checkbox" hidden
                class="{{ config.jsName }}__ignore-field"
                name="{{ ignoreField.vars.full_name }}"
                value="{{ ignoreField.vars.value }}"
                {{ isIgnored ? 'checked' }}>
            {% do ignoreField.setRendered %}

            <div class="{{ config.name }}__mode-options">
                {# `form` points to no form, so the radios group natively but are never submitted. #}
                {% for mode in ['products', 'order_total'] %}
                    {% set isOrderTotalMode = mode == 'order_total' %}
                    <label class="{{ config.name }}__mode-option">
                        <input type="radio"
                            class="{{ config.name }}__mode-input {{ config.jsName }}__mode-input {{ config.jsName }}__mode-input--{{ mode }}"
                            name="{{ config.name }}-mode"
                            form="{{ config.name }}-mode"
                            value="{{ mode }}"
                            {{ isOrderTotalMode == isIgnored ? 'checked' }}
                            {{ isOrderTotalMode and not hasOrderTolerance and not isIgnored ? 'disabled' }}
                            {{ qa('recurring-order-price-tolerances-mode-' ~ mode) }}>
                        <span class="{{ config.name }}__mode-body">
                            <span class="{{ config.name }}__mode-title">{{ ('recurring_orders.price_tolerance.mode.' ~ mode ~ '.title') | trans }}</span>
                            <span class="{{ config.name }}__mode-text">
                                {{ ('recurring_orders.price_tolerance.mode.' ~ mode ~ '.text') | trans({
                                    '%tolerance%': '<span class="' ~ config.jsName ~ '__order-tolerance-value">' ~ (orderTolerance ?: 0) ~ '</span>',
                                }) | raw }}
                            </span>
                        </span>
                    </label>
                {% endfor %}
            </div>

            <p class="{{ config.name }}__mode-hint {{ config.jsName }}__mode-hint" {{ hasOrderTolerance ? 'hidden' }}>
                {{ 'recurring_orders.price_tolerance.mode.order_total.unavailable' | trans }}
            </p>

            {{ form_errors(ignoreField) }}
        </fieldset>
    {% endblock %}
{% endblock %}

{# The selected mode card already explains what is checked. #}
{% block ignoredNotice %}{% endblock %}

{% block heading %}
    {% set withToleranceCount = data.productRows | filter(row => row.hasTolerance) | length %}
    {% set reviewsAnyIncreaseCount = data.productRows | filter(row => row.isReviewingAnyIncrease) | length %}

    <div class="{{ config.name }}__product-data-heading">
        {% block intro %}
            {{ parent() }}
        {% endblock %}

        {% block summary %}
            {{ parent() }}
        {% endblock %}
    </div>
{% endblock %}

{% block table %}
    {% set toleranceColumns = [] %}
    {% if not data.isLocked %}
        {% set toleranceColumns = toleranceColumns | merge([{
            id: 'select',
            title: 'recurring_orders.price_tolerance.bulk.select_all',
            type: 'checkbox',
            head: {
                type: 'checkbox',
            },
            options: {
                selectable: true,
            },
        }]) %}
    {% endif %}
    {% set toleranceColumns = toleranceColumns | merge([
        { id: 'product', title: 'recurring_orders.detail.order_items.column.product' },
        { id: 'unitPrice', title: 'recurring_orders.price_tolerance.products.column.unit_price' },
        { id: 'quantity', title: 'recurring_orders.detail.order_items.column.quantity' },
        { id: 'tolerance', title: 'recurring_orders.price_tolerance.products.column.tolerance', type: 'input' },
        { id: 'reviewAbove', title: 'recurring_orders.price_tolerance.products.column.review_above' },
    ]) %}

    {% set toleranceRows = [] %}
    {% for itemForm in data.form.items %}
        {% set row = data.productRows[loop.index0] %}
        {% set productName = row.item.productName ?: row.item.sku %}

        {% set productCell %}
            <div class="{{ config.name }}__product-name">
                {{- productName -}}
            </div>
            <div class="{{ config.name }}__product-meta">
                <span class="{{ config.name }}__product-sku">{{ 'recurring_orders.sku' | trans({'%sku%': row.item.sku}) }}</span>
                {% widget 'SoldByMerchantWidget' args [row.item] only %}{% endwidget %}
            </div>
        {% endset %}

        {% set reviewAboveCell %}
            <span class="{{ config.jsName }}__trigger">
                {%- if row.triggerPrice is not null -%}
                    <strong>{{ row.triggerPrice | money(true, data.currencyIsoCode) }}</strong>
                {%- else -%}
                    {{ 'recurring_orders.price_tolerance.products.any_increase' | trans }}
                {%- endif -%}
            </span>
        {% endset %}

        {% set toleranceRows = toleranceRows | merge([{
            _row: {
                class: "#{config.jsName}__row",
                attributes: {
                    'data-unit-price': row.unitPrice,
                    'data-qa': 'recurring-order-product-tolerance-row',
                },
            },
            select: { label: 'recurring_orders.price_tolerance.bulk.select_row' | trans({'%product%': productName}) },
            product: productCell,
            unitPrice: row.unitPrice | money(true, data.currencyIsoCode),
            quantity: row.quantity,
            tolerance: {
                field: itemForm.tolerance,
                fieldAttributes: {
                    class: "#{config.name}__table-input #{config.jsName}__tolerance input--sm",
                },
                cellText: '%',
            },
            reviewAbove: reviewAboveCell,
        }]) %}
    {% endfor %}

    {% include molecule('advanced-table') with {
        data: {
            columns: toleranceColumns,
            rows: toleranceRows,
        },
    } only %}
{% endblock %}

{% block note %}
    <p class="{{ config.name }}__tolerance-zero-hint">{{ 'recurring_orders.price_tolerance.products.note' | trans }}</p>
{% endblock %}
