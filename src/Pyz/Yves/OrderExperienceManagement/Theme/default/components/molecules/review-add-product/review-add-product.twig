{% extends molecule('review-add-product', '@SprykerFeature:OrderExperienceManagement') %}

{% block body %}
    {% set openModalClassName = config.jsName ~ '__open-modal' %}
    {% set addedItemsCount = data.approveForm.addedItems | length %}

    <details open>
        <summary class="{{ config.name }}__summary">
            {% block title %}
                <span class="{{ config.jsName }}__title">
                    {{ (addedItemsCount == 1 ? 'recurring_orders.review.add_product.title.singular' : 'recurring_orders.review.add_product.title') | trans({'%count%': addedItemsCount}) }}
                </span>
            {% endblock %}

            {% block titleTemplates %}
                <template data-id="{{ config.jsName }}-title-template">{{ 'recurring_orders.review.add_product.title' | trans({'%count%': '%count%'}) }}</template>
                <template data-id="{{ config.jsName }}-title-template-singular">{{ 'recurring_orders.review.add_product.title.singular' | trans({'%count%': '%count%'}) }}</template>
            {% endblock %}

            {% include atom('font-icon') with {
                class: config.name ~ '__summary-icon',
                data: {
                    name: 'keyboard_arrow_down',
                },
            } only %}
        </summary>

        {% block content %}
            {% set contentClassName = config.name ~ '__box' %}
            {{ parent() }}
        {% endblock %}

        {% block lineTemplate %}
            <template data-id="{{ config.jsName }}-line-template">
                <div
                    class="{{ config.name }}__line js-review-total-recalculator__line"
                    {{ qa(config.name ~ '-line') }}
                >
                    <span class="{{ config.name }}__line-name" {{ qa(config.name ~ '-line-name') }}>
                        <span class="{{ config.jsName }}__line-name-text"></span>
                        <small class="{{ config.name }}__line-sku {{ config.jsName }}__line-sku text-muted"></small>
                    </span>

                    {% include molecule('quantity-counter') with {
                        modifiers: ['sm'],
                        data: {
                            inputExtraClasses: config.name ~ '__line-quantity js-review-total-recalculator__line-quantity',
                        },
                        attributes: {
                            min: minimumQuantity,
                            'data-qa': config.name ~ '-line-quantity',
                        },
                    } only %}

                    <span class="{{ config.name }}__line-price {{ config.jsName }}__line-price" {{ qa(config.name ~ '-line-price') }}></span>

                    <button
                        type="button"
                        title="{{ 'recurring_orders.review.add_product.remove' | trans }}"
                        class="button button--sm button--hollow {{ config.name }}__line-remove {{ config.jsName }}__line-remove"
                        {{ qa(config.name ~ '-line-remove') }}
                    >
                        {% include atom('icon') with {
                            data: {
                                name: 'remove',
                            },
                        } only %}
                    </button>
                </div>
            </template>
        {% endblock %}
    </details>

    {% block modal %}
        {{ parent() }}
    {% endblock %}
{% endblock %}
