{% extends molecule('review-unchanged-items', '@SprykerFeature:OrderExperienceManagement') %}

{% block body %}
    <details open>
        <summary>
            {{ (data.unchangedItems | length === 1 ? 'recurring_orders.review.unchanged.title' :'recurring_orders.review.unchanged.title.plural') | trans ({'%count%': data.unchangedItems | length}) }}
            {% include atom('font-icon') with {
                class: config.name ~ '__summary-icon',
                data: {
                    name: 'keyboard_arrow_down',
                },
            } only %}
        </summary>

        {% block content %}
            {% set contentClassName = config.name ~ '__box' %}
            {{ parent() }}
        {% endblock %}
    </details>
{% endblock %}

{% block grid %}
    {% set gridClassName = config.name ~ '__item grid grid--gap js-review-total-recalculator__line' %}
    {{ parent() }}
{% endblock %}

{% block separator %}{% endblock %}

{% block itemName %}
    <strong class="{{ config.name }}__item-name">{{ item.productName }}</strong>

    {% for flag in item.flags %}
        {% include molecule('status') with {
            data: {
                label: (data.itemFlagLabelMap[flag] ?? flag) | trans,
                status: data.itemFlagBadgeMap[flag],
            },
        } only %}
    {% endfor %}
{% endblock %}

{% block soldBy %}
    <div class="grid grid--gap-smaller {{ config.name }}__item-meta">
        <div class="col">
            {% if item.sku %}
                <small class="{{ config.name }}__item-sku">{{ 'recurring_orders.sku' | trans({'%sku%': item.sku })}}</small>
            {% endif %}
        </div>
        <div class="col">{{ parent() }}</div>
    </div>
{% endblock %}

{% block itemPriceInfo %}
    <span class="{{ config.name }}__price">
        {{ currentQuantity }}x
        {% if priceChange %}
            <s>{{ referencePrice | money(true, data.currencyIsoCode) }}</s>
        {% endif %}
        {{ unitPrice | money(true, data.currencyIsoCode) }}
    </span>
    {% if priceChange %}
        {% set itemTolerance = item.priceTolerancePercent %}
        <br>
        <small class="text-muted" {{ qa('recurring-order-review-unflagged-price-change') }}>
            {% if priceChange.current < priceChange.previous %}
                ({{ 'recurring_orders.review.price_note.decreased' | trans }})
            {% elseif data.isProductCheckIgnored %}
                ({{ 'recurring_orders.review.price_note.within_order_tolerance' | trans({'%tolerance%': data.orderTolerance.trim() ~ '%'}) }})
            {% else %}
                ({{ 'recurring_orders.review.price_note.within_tolerance' | trans({'%tolerance%': itemTolerance.trim() ~ '%'}) }})
            {% endif %}
        </small>
    {% endif %}
{% endblock %}
