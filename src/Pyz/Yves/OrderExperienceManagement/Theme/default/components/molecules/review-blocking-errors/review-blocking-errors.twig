{% extends  molecule('review-blocking-errors', '@SprykerFeature:OrderExperienceManagement') %}

{% block body %}
    <div {{ qa('recurring-order-review-blocking-errors') }}>
        {% embed molecule('flash-message') with {
            modifiers: ['warning'],
            class: 'spacing-bottom--biggest',
            data: {
                isStatic: true,
            },
            embed: {
                blockingErrors: data.blockingErrors,
            },
        } only %}
            {% block content %}
                <div class="{{ config.name }}__content">
                    {% if data.title is not empty %}
                        <h6 class="{{ config.name }}__title">{{ data.title | trans }}</h6>
                    {% endif %}

                    <div class="{{ config.name }}__text">
                        {% for blockingError in embed.blockingErrors %}
                            <p>{{ blockingError.message | trans(blockingError.parameters ?? {}) }}</p>
                        {% endfor %}
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
