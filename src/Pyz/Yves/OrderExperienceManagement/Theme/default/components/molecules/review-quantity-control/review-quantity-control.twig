{% extends molecule('review-quantity-control', '@SprykerFeature:OrderExperienceManagement') %}

{% block quantity %}
    {% include molecule('quantity-counter') with {
        modifiers: ['sm'],
        data: {
            inputExtraClasses: config.name ~ '__input ' ~ config.jsName ~ '__input js-review-total-recalculator__line-quantity',
        },
        attributes: {
            min: 1,
            value: quantity,
            'data-qa': 'recurring-order-review-line-quantity',
        },
    } only %}
{% endblock %}

{% block removeButton %}
    {% set removeButtonClassName = config.jsName ~ "__remove-toggle button button--sm button--hollow" %}
    {{ parent() }}
{% endblock %}