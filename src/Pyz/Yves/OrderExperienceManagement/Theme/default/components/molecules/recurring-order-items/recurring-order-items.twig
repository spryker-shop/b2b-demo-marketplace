{% extends molecule('recurring-order-items', '@SprykerFeature:OrderExperienceManagement') %}

{% block title %}{% endblock %}

{% block table %}
    {% set itemColumns = [
        { id: 'product', title: 'recurring_orders.detail.order_items.column.product' },
        { id: 'price-tolerance', title: 'recurring_orders.detail.order_items.column.price-tolerance', tooltip: 'recurring_orders.detail.order_items.column.price-tolerance.tooltip', type: 'status' },
        { id: 'quantity', title: 'recurring_orders.detail.order_items.column.quantity'},
        { id: 'price', title: 'recurring_orders.detail.order_items.column.price' },
        { id: 'total', title: 'recurring_orders.detail.order_items.column.total' },
    ] %}

    {% set itemRows = [] %}
    {% for item in data.schedule.items %}
        {% set soldBy %}{% widget 'SoldByMerchantWidget' args [item] only %}{% endwidget %}{% endset %}
        {% set itemQuantity = item.nextDeliveryQuantity ?? item.quantity %}

        {% set productCell %}
            <div>
                <strong class="{{ config.name }}__product-name" title="{{- item.productName ?: item.sku -}}">{{- item.productName ?: item.sku -}}</strong>
                
                {%- if item.productName %}<span class="{{ config.name }}__product-sku">{{ 'recurring_orders.sku' | trans({'%sku%': item.sku}) }}</span>{% endif -%}
                {%- if item.configurableBundleName %}
                    <br><small class="text-muted">{{ 'recurring_orders.item.configurable_bundle_label' | trans({'%name%': item.configurableBundleName | trans | e}) }}</small>
                {%- endif -%}
                {%- for flag in item.flags %}
                    <br><span class="status status--{{ data.itemFlagBadgeMap[flag] ?? '' }}">{{ (data.itemFlagLabelMap[flag] ?? flag) | trans }}</span>
                {%- endfor -%}
                {{- soldBy -}}
            </div>
        {% endset %}

        {% set quantityCell %}
            <span class="{{ config.jsName }}__qty-display" data-qa="recurring-order-detail-item-quantity">{{ itemQuantity }}</span>
            <input type="number" class="{{ config.jsName }}__qty-input is-hidden" data-item-id="{{ item.idRecurringScheduleItem }}" value="{{ itemQuantity }}" min="1">
        {% endset %}

        {% set priceCell = item.referenceGrossPrice | money(true, data.schedule.currencyIsoCode) %}

        {% set totalCell = item.itemTotal | money(true, data.schedule.currencyIsoCode) %}

        {% set itemRows = itemRows | merge([{
            product: productCell,
            'price-tolerance': { label: item.priceTolerance | default('Off') | lower | trans, status: 'primary' },
            quantity: quantityCell,
            price: priceCell,
            total: totalCell,
        }]) %}
    {% endfor %}

    {% embed molecule('advanced-table') with {
        class: config.name ~ '__table',
        data: {
            columns: itemColumns,
            rows: itemRows,
            emptyText: 'recurring_orders.detail.order_items.empty',
        },
        embed: {
            configName: config.name,
        },
    } only %}
        {% block headCol %}
            <div class="{{ config.name }}__heading">
                {{ columnData.title | default('') | trans }}
                {{ _self.sortingIcon(columnData, config, data) }}

                {% if columnData.tooltip is defined %}
                    {% include atom('font-icon') with {
                        class: embed.configName ~ '__tooltip-trigger',
                        attributes: {
                            title: columnData.tooltip | trans,
                        },
                        data: {
                            name: 'info',
                        },
                    } only %}
                {% endif %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block summary%}
    <div class="{{ config.name }}__summary">
        <div class="col col--expand">
            <strong class="{{ config.name }}__summary-label">{{ 'recurring_orders.detail.estimated_total.label' | trans }}</strong>
            <br>
            <span class="{{ config.name }}__note">{{ 'recurring_orders.detail.estimated_total.info' | trans }}</span>
        </div>
        <div class="col {{ config.name }}__summary-total">{{ data.schedule.estimatedTotal | money(true, data.schedule.currencyIsoCode) }}</div>
    </div>
{% endblock %}
