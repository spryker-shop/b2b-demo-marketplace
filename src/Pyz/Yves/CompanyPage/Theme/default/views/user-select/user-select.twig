{% extends template('page-layout-customer', 'CustomerPage') %}

{% define data = {
    form: _view.form,
    title: 'company_user.change_company_user' | trans,
    activePage: 'change-company-user',
} %}

{% block breadcrumbs %}
    {% include molecule('breadcrumb') with {
        data: {
            steps: [
                {
                    label: 'customer.account' | trans,
                    url: url('customer/overview')
                }, {
                    label: 'company_user.change_company_user' | trans
                }
            ]
        }
    } only %}
{% endblock %}

{% block customerContent %}
    {% include molecule('action-bar') with {
        data: {
            title: 'company_user.change_company_user' | trans,
        },
    } only %}

    {% include molecule('form') with {
        data: {
            form: data.form,
            options: {
                action: url('company/user/select'),
            },
            submit: {
                enable: true,
            },
        },
    } only %}
{% endblock %}
