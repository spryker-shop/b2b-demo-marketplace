{% extends view('product-replacement-for-list', '@SprykerShop:ProductReplacementForWidget') %}

{% block body %}
    {% if data.products is not empty %}
        {# The list as the traceable events identify it, e.g. GA4 view_item_list; a constant English name, as the title the shopper sees is translated
           and would split the list by locale in the reports. #}
        <div class="product-replacement" data-item-list-id="product_replacements" data-item-list-name="Product replacements">
            <h2 class="product-replacement__title title title--h4">
                {{ 'replacement_for_widget.replacement_for' | trans }}
            </h2>

            {% embed molecule('slick-carousel') with {
                modifiers: ['full-width', 'equal-height', 'products', 'full-height'],
                data: {
                    slides: data.products,
                },
                attributes: {
                    'slider-config': '{
                        "slidesToShow": 4,
                        "dots": false,
                        "arrows": true,
                        "adaptiveHeight": true
                    }',
                },
            } only %}
                {% block slides %}
                    {% for slide in data.slides %}
                        {% widget 'PdpProductReplacementForListWidget' args [slide] only %}{% endwidget %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}

            {% block productTrackingDetails %}
                {% widget 'ProductTrackingDetailsWidget' args [data.products] only %}{% endwidget %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
