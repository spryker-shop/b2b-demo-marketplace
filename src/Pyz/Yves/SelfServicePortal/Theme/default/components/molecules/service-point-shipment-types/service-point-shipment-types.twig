{% extends molecule('service-point-shipment-types', '@SprykerFeature:SelfServicePortal') %}

{% block extraClass %} {% if data.shipmentTypes | length or data.isConcreteProduct %}spacing-bottom--big{% else %}is-hidden{% endif %}{% endblock %}

{% block ajax %}
    {% set dynamicParams = {
        'service-type-key': {
            selector: ".#{config.name}__radio input:checked",
            attribute: 'data-service-type-key',
        },
        'shipment-type-uuid': {
            selector: ".#{config.name}__radio input:checked",
            attribute: 'value',
        },
        'service-type-uuid': {
            selector: ".#{config.name}__radio input:checked",
            attribute: 'data-service-type-uuid',
        },
        quantity: {
            selector: 'packaging-unit-quantity-selector select[name="quantity"]',
            attribute: 'value',
        },
        'id-product-concrete': {
            selector: "[data-service-point-product-concrete-id-input]",
            attribute: 'value',
        },
        'service-point-uuid': {
            selector: '[data-service-point-uuid-input]',
            attribute: 'value',
        },
    } %}

    {% include molecule('ajax-provider') with {
        class: ajaxProviderClass,
        attributes: {
            'fetch-on-load': true,
            url: url('customer/ssp-service-point-widget-content'),
            'dynamic-params': dynamicParams | json_encode,
        },
    } only %}

    {% include molecule('ajax-loader') with {
        attributes: {
            'provider-class-name': ajaxProviderClass,
        },
    } only %}

    {% include molecule('ajax-renderer') with {
        attributes: {
            'provider-class-name': ajaxProviderClass,
            'target-class-name': ajaxContainerClass,
            'mount-after-render': true,
        },
    } only %}

    {% include molecule('ajax-form-submitter') with {
        attributes: {
            'provider-class-name': ajaxProviderClass,
            'trigger-attribute': ajaxTriggerAttribute,
            event: 'change',
            'is-provider-trigger': 'true',
        },
    } only %}
{% endblock %}

{% block render %}
    <div class="{{ ajaxContainerClass }} spacing-bottom"></div>
{% endblock %}

{% block types %}
    <div class="spacing-bottom--biggest {% if not requiredServicePoint and shipmentTypeLength == 1 %}is-hidden{% endif %}">
        <div class="label spacing-bottom--big">{{ 'self_service_portal.service.product.shipment_types' | trans }}</div>

        <div class="grid">
            {% for shipmentType in data.shipmentTypes %}
                {{ block('type') }}
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block datepicker %}
    {% if data.isServiceDateTimeFieldVisible %}
        {#
            Fixed seminar dates per seminar module (concrete SKU) and training center (service point
            key), as specified in CC-39954. weekday follows Date.getDay(): 1 = Monday ... 4 = Thursday.
        #}
        {% set seminarSlots = {
            'SRV-TR-SEM-002': {
                sp5: { weekday: 1, from: '09:00', to: '12:00' },
                sp6: { weekday: 2, from: '09:00', to: '12:00' },
                sp7: { weekday: 1, from: '09:00', to: '12:00', everyOtherWeek: true },
            },
            'SRV-TR-SEM-001': {
                sp5: { weekday: 1, from: '13:00', to: '17:00' },
                sp6: { weekday: 2, from: '13:00', to: '17:00' },
                sp7: { weekday: 1, from: '13:00', to: '17:00', everyOtherWeek: true },
            },
            'SRV-TR-SEM-003': {
                sp5: { weekday: 4, from: '09:00', to: '17:00' },
                sp6: { weekday: 3, from: '09:00', to: '17:00' },
                sp7: { weekday: 3, from: '09:00', to: '17:00', everyOtherWeek: true },
            },
        } %}
        {% set isSeminar = data.product.sku starts with 'SRV-TR-SEM' %}
        {% set productSlots = seminarSlots[data.product.sku] | default({}) %}

        <div class="spacing-bottom--biggest">
            {# `only` isolates the widget body, so everything the picker needs must travel through `embed`. #}
            {% widget 'LanguageSwitcherWidget' args [app.request.pathInfo, app.request.queryString, app.request.requestUri] with {
                embed: {
                    input: {
                        label: 'self_service_portal.service.product.label.service_date_time',
                        attrs: {
                            id: 'service-point-shipment-type-datetime',
                            name: data.formFieldItemMetadataScheduledAt,
                            placeholder: 'self_service_portal.service.product.service_date_time' | trans,
                        },
                    },
                    isSeminar: isSeminar,
                    productSlots: productSlots,
                    ajaxProviderClass: ajaxProviderClass,
                },
            } only %}
                {% block body %}
                    {% include molecule('date-time-picker') with {
                        data: {
                            input: embed.input,
                        },
                        attributes: {
                            language: data.currentLanguage,
                            config: {
                                dateFormat: 'Y-m-d H:i',
                                minDate: 'today',
                            } | json_encode,
                            'fixed-service-slots': embed.isSeminar,
                            'service-slots': embed.productSlots | json_encode,
                            'service-point-key-selector': '[data-service-point-key-input]',
                            'service-point-provider-class': embed.isSeminar ? embed.ajaxProviderClass : '',
                        },
                    } only %}
                {% endblock %}
            {% endwidget %}
        </div>
    {% endif %}
{% endblock %}

{% block body %}
    {% set shipmentTypeLength = data.shipmentTypes | length %}

    {% if shipmentTypeLength %}
        {{ block('types') }}

        {{ block('datepicker') }}

        {% if requiredServicePoint %}
            {{ block('servicePointSelector') }}
            <input data-service-point-uuid-input type="hidden" name="{{ data.formFieldServicePointUuid }}" value="">
        {% endif %}

        <input data-service-point-product-concrete-id-input type="hidden" value="{{ data.product.idProductConcrete }}">

        {% if data.hasOnlyDeliveryLikeShipmentType %}
            {% set shipmentType = data.shipmentTypes | first %}
		    <input type="hidden" name="{{ data.formFieldShipmentTypeUuid }}" value="{{ shipmentType.value }}">
        {% endif %}
    {% else %}
        {% block empty%}
            {% if data.isConcreteProduct %}
                {% include molecule('alert') with {
                    modifiers: ['alt'],
                    data: {
                        content: 'self_service_portal.service.product.no_shipment_types_available' | trans,
                        icon: 'action-warning-triangle',
                    },
                } only %}
            {% endif %}
        {% endblock %}
    {% endif %}
{% endblock %}
