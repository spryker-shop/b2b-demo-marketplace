{% extends molecule('product-cart-items-list', 'SprykerShop:CartPage') %}

{% block body %}
    {% set canEditItems = data.isQuoteEditable and can('ChangeCartItemPermissionPlugin', data.cart.idQuote) %}
    {% set canRemoveItems = data.isQuoteEditable and can('RemoveCartItemPermissionPlugin') %}
    {% set canSeePrice = can('SeePricePermissionPlugin') %}

    {% widget 'ListCartItemsByShipmentTypeWidget' args [data.cartItems] with {
        embed: {
            cart: data.cart,
            cartItems: data.cartItems,
            isQuoteEditable: data.isQuoteEditable,
            canEditItems: canEditItems,
            canRemoveItems: canRemoveItems,
            canSeePrice: canSeePrice,
            attributes: data.attributes,
            ajaxTriggerAttribute: data.ajaxTriggerAttribute,
        },
    } only %}
        {% block cartItem %}
            {% if not cartItem.configuredBundleItem | default %}
                {% include molecule('product-cart-item', 'CartPage') with {
                    data: {
                        list: embed.cart,
                        listItem: cartItem,
                        attributes: embed.attributes[cartItem.sku] | default([]),
                        canEdit: embed.canEditItems,
                        canRemove: embed.canRemoveItems,
                        canSeePrice: embed.canSeePrice,
                        isLazyDetails: true,
                        hasAdditionalTitle: cartItem.cartNote | default(false),
                        currencyIsoCode: embed.cart.currency.code | default(null),
                        ajaxTriggerAttribute: embed.ajaxTriggerAttribute,
                    },
                } only %}
            {% endif %}
        {% endblock %}
    {% nowidget %}
    {% for cartItem in data.cartItems %}
            {% block cartItem %}
                {% if not cartItem.configuredBundleItem | default %}
                    {% include molecule('product-cart-item', 'CartPage') with {
                        data: {
                            list: data.cart,
                            listItem: cartItem,
                            attributes: data.attributes[cartItem.sku] | default([]),
                            canEdit: canEditItems,
                            canRemove: canRemoveItems,
                            canSeePrice: canSeePrice,
                            isLazyDetails: true,
                            hasAdditionalTitle: cartItem.cartNote | default(false),
                            currencyIsoCode: data.cart.currency.code | default(null),
                            ajaxTriggerAttribute: data.ajaxTriggerAttribute,
                        },
                    } only %}
                {% endif %}
            {% endblock %}
        {% endfor %}
    {% endwidget %}
{% endblock %}
