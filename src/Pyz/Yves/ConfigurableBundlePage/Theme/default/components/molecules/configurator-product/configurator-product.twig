{% extends molecule('configurator-product', '@SprykerShop:ConfigurableBundlePage') %}

{% block extraClass %}{% endblock %}

{% block body %}
    <div class="{{ config.name }}__container">
        {{ block('imageContainer') }}
        {{ block('content') }}
        {{ block('actionsContainer') }}
    </div>
{% endblock %}

{% block imageContainer %}
    {% set extraClass = '' %}
    {% set modifiers = ['configurator-slot', 'spaceless', 'expand'] %}

    {{ parent() }}
{% endblock %}

{% block image %}
    <div class="{{ config.name }}__image">
        {{ block('productThumbnail') }}
    </div>
{% endblock %}

{% block content %}
    <div class="{{ config.name }}__content">
        {{ block('name') }}

        {% block sku %}
            {% if data.sku %}
                <span class="{{ config.name }}__sku">{{ 'configurable_bundle_page.configurator.sku' | trans }} {{ data.sku }}</span>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}

{% block actionsContainer %}
    {% if can('SeePricePermissionPlugin') or data.isActionActive %}
        <div class="{{ config.name }}__actions">
            {% block price %}
                {% if can('SeePricePermissionPlugin') %}
                    {% widget 'PriceProductWidget' args [data.product] with {
                        embed: {
                            currencyIsoCode: data.currencyIsoCode,
                            priceClass: config.name ~ '__price',
                        },
                    } only %}
                        {% block body %}
                            {% if data.currentProductPrice.prices %}
                                {% include molecule('money-price') with {
                                    class: embed.priceClass,
                                    modifiers: ['block'],
                                    data: {
                                        amount: data.currentProductPrice.prices.DEFAULT | default(null),
                                        originalAmount: data.currentProductPrice.prices.ORIGINAL | default(null),
                                        currencyIsoCode: embed.currencyIsoCode,
                                    },
                                } only %}
                                {% widget 'ProductGrossMarginWidget' args [data.currentProductPrice.grossMargin ?? 0, 'volume-price'] %}{% endwidget %}
                            {% endif %}
                        {% endblock %}
                    {% endwidget %}
                {% endif %}
            {% endblock %}

            {% block action %}
                {% if data.isActionActive %}
                    {{ parent() }}
                {% endif %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
