{% extends molecule('configured-bundle-total', '@SprykerShop:ConfigurableBundlePage') %}

{% block extraClass %}{% endblock %}

{% block title %}
    <h2 class="{{ config.name }}__title">{{- 'configurable_bundle_page.configurator.summary_page_total' | trans -}}</h2>
{% endblock %}

{% block price %}
    {% if can('SeePricePermissionPlugin') %}
        {% include molecule('money-price') with {
            class: config.name ~ '__price',
            modifiers: ['block'],
            data: {
                amount: data.total,
            },
        } only %}
    {% else %}
        <span class="{{ config.name }}__note">{{- 'customer.access.cannot_see_price' | trans -}}</span>
    {% endif %}
{% endblock %}
