{% extends view('summary', '@SprykerShop:ConfigurableBundlePage') %}

{% block title %}{% endblock %}

{% block content %}
    <div class="configurator">
        {% include molecule('configurator-header', 'ConfigurableBundlePage') with {
            data: {
                title: data.title,
                backUrl: path('configurable-bundle/configurator/template-selection'),
                backLabel: 'configurable_bundle_page.configurator.slot_page.back_link' | trans,
            },
        } only %}

        <div class="configurator__content">
            {% block summaryContentInner %}{{ parent() }}{% endblock %}
        </div>
    </div>
{% endblock %}

{% block summarySidebar %}
    {% block summarySidebarInner %}
        {% include molecule('configurator-tabs', 'ConfigurableBundlePage') with {
            data: {
                form: data.form,
                configurableBundleTemplateStorage: data.configurableBundleTemplateStorage,
                isSummaryActive: true,
            },
        } only %}
    {% endblock %}
{% endblock %}

{% block summaryProducts %}
    <div class="configurator__summary">
        {% block summaryProductsInner %}
            {% include molecule('selected-product-list', 'ConfigurableBundlePage') with {
                data: {
                    form: data.form,
                    products: data.products,
                    configurableBundleTemplateStorage: data.configurableBundleTemplateStorage,
                },
            } only %}

            <div class="configurator__summary-aside">
                {% block bundleTotal %}{{ parent() }}{% endblock %}

                {% block summaryForm %}
                    <div class="configurator__summary-actions">
                        {% block summaryFormInner %}
                            {% if can('SeeAddToCartPermissionPlugin') %}
                                {% include molecule('configurator-state-form', 'ConfigurableBundlePage') with {
                                    data: {
                                        form: data.form.createView,
                                        submitButtonText: 'configurable_bundle_page.configurator.add_to_cart' | trans,
                                        submitButtonModifiers: ['expand'],
                                        method: 'POST',
                                        action: path(
                                            'configurable-bundle/configurator/add-to-cart', {
                                                'idConfigurableBundleTemplate': data.configurableBundleTemplateStorage.idConfigurableBundleTemplate,
                                            }
                                        ),
                                    },
                                } only %}
                            {% endif %}

                            <a href="{{ path('configurable-bundle/configurator/template-selection') }}" class="button button--hollow button--expand">
                                {{ 'general.cancel.button' | trans }}
                            </a>
                        {% endblock %}
                    </div>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
