{% extends view('slots', '@SprykerShop:ConfigurableBundlePage') %}

{% block title %}{% endblock %}

{% block content %}
    <div class="configurator">
        {% include molecule('configurator-header', 'ConfigurableBundlePage') with {
            data: {
                title: data.title,
                backUrl: path('configurable-bundle/configurator/template-selection'),
                backLabel: 'configurable_bundle_page.configurator.slot_page.back_link' | trans,
            },
        } only %}

        <div class="configurator__content">
            {% block configuratorContent %}{{ parent() }}{% endblock %}
        </div>
    </div>
{% endblock %}

{% block configuratorSidebar %}
    {% block configuratorSidebarInner %}
        {% include molecule('configurator-tabs', 'ConfigurableBundlePage') with {
            data: {
                form: data.form,
                configurableBundleTemplateStorage: data.configurableBundleTemplateStorage,
                selectedSlotId: data.selectedSlotId,
                isSummaryUnlocked: data.isSummaryPageUnlocked,
            },
        } only %}
    {% endblock %}
{% endblock %}

{% block configuratorProductsInner %}
    {% set wrapperClasses = 'configurator__panel' %}

    {{ parent() }}
{% endblock %}

{% block configuratorSelectedItem %}
    {% include molecule('configurator-product', 'ConfigurableBundlePage') with {
        modifiers: ['selected'],
        data: {
            product: data.selectedProduct,
            form: data.form.createView,
            selectedSlotId: data.selectedSlotId,
            isSelected: true,
        },
    } only %}
{% endblock %}

{% block configuratorUnselectedProducts %}
    {% widget 'ProductConcreteSearchGridWidget' args [data.productConcreteCriteriaFilter] %}
        {% block body %}
            {% for product in data.products %}
                {% include molecule('configurator-product', 'ConfigurableBundlePage') with {
                    data: {
                        product: product,
                        form: data.form.createView,
                        selectedSlotId: data.selectedSlotId,
                    },
                } only %}
            {% endfor %}

            {% if data.products is empty %}
                <p class="spacing-x">{{ 'product_search_widget.search.no_results' | trans }}</p>
            {% endif %}
        {% endblock %}
    {% endwidget %}
{% endblock %}
