{% extends view('payment', '@SprykerShop:CheckoutPage') %}

{# customForms data property is necessary for Eco payments integrations #}
{% define data = {
    stepNumder: 3,
    customForms: {
        'Stripe/stripe': ['stripe'],
    },
} %}

{% block containerClass %}container--small{% endblock %}

{% block content %}
    {% embed molecule('form') with {
        modifiers: ['checkout-form'],
        data: {
            form: data.forms.payment,
            options: {
                attr: {
                    id: 'payment-form',
                },
            },
            submit: {
                enable: true,
                text: 'checkout.step.summary' | trans,
                class: 'form__action--expand-sm-md button button--big',
            },
            cancel: {
                enable: true,
                url: data.backUrl,
                text: 'general.back.button' | trans,
                icon: '',
                class: 'form__action--expand-sm-md button button--big button--tertiary button--back',
            },
        },
        embed: {
            customForms: data.customForms,
        },
    } only %}
        {% block fieldset %}
            {% set paymentSelection = data.form.paymentSelection %}
            {% set hasError = paymentSelection.vars.errors | length > 0 %}

            {{ form_errors(paymentSelection) }}

            {% for groupName, choices in paymentSelection.vars.choices %}
                {% embed molecule('payment-method-group', 'CheckoutPage') with {
                    data: {
                        title: groupName | trans,
                    },
                    embed: {
                        form: data.form,
                        customForms: embed.customForms,
                        groupIndex: loop.index0,
                        choices: choices,
                        hasError: hasError,
                    },
                } only %}
                    {% block list %}
                        <ul class="checkout-list checkout-list--payment">
                            {% for choiceKey in embed.choices | keys %}
                                {% set toggler = embed.form.paymentSelection[choiceKey] %}

                                <li class="checkout-list__item">
                                    {% embed molecule('form') with {
                                        modifiers: ['checkout-form', 'hidden-actions'],
                                        data: {
                                            form: embed.form[toggler.vars.name],
                                            enableStart: false,
                                            enableEnd: false,
                                        },
                                        embed: {
                                            customForms: embed.customForms,
                                            index: loop.index ~ '-' ~ embed.groupIndex,
                                            toggler: toggler,
                                            hasError: embed.hasError,
                                        },
                                    } only %}
                                        {% block fieldset %}
                                            {% set customForm = embed.customForms[data.form.vars.template_path] ?? null %}
                                            {% set hasDetails = customForm is not null or data.form | length > 0 %}

                                            {# Details are rendered here because parent() is only available in this block #}
                                            {% set detailsContent %}
                                                {% if customForm is not null %}
                                                    {% include view(customForm | first, customForm | last) with {
                                                        form: data.form.parent,
                                                    } only %}
                                                {% elseif hasDetails %}
                                                    {{ parent() }}
                                                {% endif %}
                                            {% endset %}

                                            {% embed molecule('payment-method-option', 'CheckoutPage') with {
                                                modifiers: embed.hasError ? ['error'] : [],
                                                data: {
                                                    hasDetails: hasDetails,
                                                    detailsClass: 'js-payment-method-' ~ embed.index,
                                                },
                                                embed: {
                                                    toggler: embed.toggler,
                                                    index: embed.index,
                                                    detailsContent: detailsContent,
                                                },
                                            } only %}
                                                {% block toggler %}
                                                    {{ form_row(embed.toggler, {
                                                        required: false,
                                                        component: molecule('toggler-radio'),
                                                        attributes: {
                                                            'target-class-name': 'js-payment-method-' ~ embed.index,
                                                            'class-to-toggle': 'is-hidden',
                                                            'aria-label': 'checkout_page.aria_label.choose.as.active' | trans({
                                                                '%optionValue%': embed.toggler.vars.label | trans,
                                                            }),
                                                        },
                                                        rowAttr: {
                                                            class: 'toggler-radio toggler-radio--checkout',
                                                        },
                                                    }) }}
                                                {% endblock %}

                                                {% block details %}
                                                    {{ embed.detailsContent }}
                                                {% endblock %}
                                            {% endembed %}
                                        {% endblock %}
                                    {% endembed %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
