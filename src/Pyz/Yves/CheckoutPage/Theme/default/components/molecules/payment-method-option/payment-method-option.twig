{% extends model('component') %}

{% define config = {
    name: 'payment-method-option',
} %}

{% define data = {
    hasDetails: false,
    detailsClass: '',
} %}

{% block body %}
    {% block toggler %}{% endblock %}

    {% if data.hasDetails %}
        <div class="{{ config.name }}__details {{ data.detailsClass }} is-hidden">
            {% block details %}{% endblock %}
        </div>
    {% endif %}
{% endblock %}
