{% extends view('order-detail', '@SprykerShop:CustomerPage') %}

{% block breadcrumbs %}
    {% include molecule('breadcrumb') with {
        data: {
            steps: [{
                label: 'customer.account' | trans,
                url: url('customer/overview'),
            },{
                label: 'customer.account.order_history' | trans,
                url: url('customer/order'),
            },{
                label: 'customer.account.view_order' | trans,
            }]
        }
    } only %}
{% endblock %}

{% block customerContent %}
    {% widget 'CartReorderItemsWidget' args [
        data.order,
        data.shipmentGroups,
        data.orderShipmentExpenses,
    ] only %}
    {% endwidget %}

    <div class="box box--medium">
        {% widget 'CommentThreadWidget' args [
            data.order.idSalesOrder,
            'sales_order',
            app.request.requestUri,
            data.order.commentThread
        ] only %}
        {% endwidget %}
    </div>
{% endblock %}

{% block eventTracker %}
    {# Reordering all items of the order: the core trigger reads the ordered items by the core table's item class, which the project's
       order cards do not carry, so the project adds the trigger for its own markup. Reordering selected items, the order's currency
       and the other order page events come from the core template. #}
    {% set events = {
        list: events.list | merge([
            {
                event: 'ADD_TO_CART',
                name: 'click',
                triggers: [
                    {
                        selector: '.js-cart-reorder-all',
                        data: {
                            orderPage: {
                                selector: 'body',
                                closest: true,
                                flatten: true,
                                composed: {
                                    products: {
                                        multi: true,
                                        selector: '.order-detail-table [tracking-details]',
                                        attribute: 'tracking-details',
                                    },
                                },
                            },
                        },
                    },
                ],
            },
        ]),
        data: events.data,
    } %}

    {{ parent() }}
{% endblock %}
