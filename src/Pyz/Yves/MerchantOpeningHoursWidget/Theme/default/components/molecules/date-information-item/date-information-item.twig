{% extends model('component') %}

{% define config = {
    name: 'date-information-item',
} %}

{% define data = {
    scheduleList: [],
    subTitle: '',
} %}

{% block component %}
    {% if data.scheduleList %}{{ parent() }}{% endif %}
{% endblock %}

{% block extraClass %}{% endblock %}

{% block body %}
    {% block title %}
        {% if data.title %}
            <h5 class="{{ config.name }}__title">{{ data.title }}</h5>
        {% endif %}

        {% if data.subTitle %}
            <h5 class="{{ config.name }}__subtitle">{{ data.subTitle }}</h5>
        {% endif %}
    {% endblock %}

    {% block text %}
        {% for scheduleItem in data.scheduleList %}
            {% set date = scheduleItem.noteGlossaryKey ? scheduleItem.date ~ ' (' ~ scheduleItem.noteGlossaryKey ~ ')' : scheduleItem.date %}
            {% set time = scheduleItem.time ? scheduleItem.time | replace({'|' : ', '}) %}
            
            <div class="{{ config.name }}__grid">
                <div class="{{ config.name }}__date">
                    {{ scheduleItem.date }}
                    <span class="{{ config.name }}__date-note">{{ scheduleItem.noteGlossaryKey  }}</span>
                </div>
                <div class="{{ config.name }}__time">{{ time | raw }}</div>
            </div>
        {% endfor %}
    {% endblock %}
{% endblock %}

